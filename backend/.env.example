# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Replace with your local MongoDB connection string or Atlas cluster URI
MONGO_URI=mongodb://localhost:27017/eventpulse

# Authentication - Google Sign-In (OAuth 2.0 Client ID)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# Authentication - JWT Secret
# Use a strong secure secret key for signing JSON Web Tokens
JWT_SECRET=your_jwt_signing_secret_here
